---
/**
 * Works in justified rows (like pictures hung side by side): each row has one height, every painting
 * keeps its real proportions, the reading order stays left → right. Pure CSS, see ArtworkCard.
 *
 *   <ArtworkGrid opere={list} headingLevel={3} priorityCount={2} />
 */
import ArtworkCard from './ArtworkCard.astro';
import type { Opera } from './lib/opere';

interface Props {
  opere: Opera[];
  headingLevel?: 2 | 3;
  /** How many of the first covers are above the fold (loaded eagerly). */
  priorityCount?: number;
  label?: string;
}

const { opere, headingLevel = 3, priorityCount = 0, label } = Astro.props;
---

<ul class="artwork-grid" role="list" aria-label={label}>
  {opere.map((opera, i) => <ArtworkCard opera={opera} headingLevel={headingLevel} priority={i < priorityCount} />)}
</ul>

<style>
  .artwork-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--grid-row-gap) var(--grid-gap);
  }

  /* Takes the free space of the last row, so its paintings keep the target size instead of stretching. */
  .artwork-grid::after {
    content: '';
    flex: 1e6 1 0;
  }
</style>
