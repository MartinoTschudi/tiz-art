---
/**
 * Photos of one work on its page (frames 1f / 1g): the stage with the work's brushstroke behind the
 * painting, and the photos as a row of thumbnails under it when there is more than one.
 *
 * - The painting is always whole: as wide as `min(fitW × stage width, fitH × stage height × ratio)`
 *   (≥ 640 px: 88 % × 92 % of a stage 600 / 720 px high, lower on short screens; phone: a 440 px box it
 *   fills). The numbers are also in lib/opera.ts (`sizes`); keep them in step.
 * - The stroke (inset 16% 14% 10% 4%, phone 20% 20% 6% −10%, rotate −5deg) wipes in on every load.
 * - The cover's frame carries `view-transition-name: opera-<slug>`, the same name as in HungWorks, so
 *   the painting moves from the list to this page. Never put the stage inside a [data-reveal] element.
 * - Clicking the painting opens the full-screen viewer (ImageViewer) at the photo on the stage.
 * - With JS a thumbnail swaps the photo on the stage with a 700 ms crossfade; without JS the stage
 *   shows the cover and every link (stage and thumbnails) opens the full-size JPEG.
 *
 * Hooks for the script below: [data-gallery] > [data-gallery-slide="<i>"] (one per photo, the first
 * is .is-current, the others [hidden]) · [data-gallery-thumb="<i>"] · [data-gallery-status].
 */
import ResponsivePicture from './ResponsivePicture.astro';
import ImageViewer from './ImageViewer.astro';
import Stroke from './Stroke.astro';
import { altText, type Opera } from './lib/opere';
import { viewerSource } from './lib/images';
import { stageSizes, thumbSizes } from './lib/opera';

interface Props {
  opera: Opera;
  /** Colour of the stroke, e.g. "var(--tiz-terracotta)" (lib/opere.ts → operaPaintVar). */
  paint: string;
}

const { opera, paint } = Astro.props;
const { data } = opera;
const photos = await Promise.all(
  data.immagini.map(async (image, i) => {
    const ratio = image.width / image.height;
    return { image, ratio: ratio.toFixed(4), alt: altText(data, i), stage: stageSizes(ratio), thumb: thumbSizes(ratio), viewer: await viewerSource(image) };
  }),
);
const viewerImages = photos.map(({ viewer, alt }) => ({ ...viewer, alt }));
const many = photos.length > 1;
---

<div class="gallery" data-viewer-gallery data-gallery>
  <div class="gallery__stage" style={`--ratio: ${photos[0].ratio}`}>
    <Stroke class="gallery__stroke" color={paint} />
    {
      photos.map((photo, i) => (
        <div
          class:list={['gallery__slide', i === 0 && 'is-current']}
          style={`--ratio: ${photo.ratio}`}
          hidden={i > 0}
          data-gallery-slide={i}
        >
          <a
            class="gallery__frame"
            href={photo.viewer.full}
            style={i === 0 ? `view-transition-name: opera-${opera.id}` : undefined}
            data-viewer-open={i}
          >
            <ResponsivePicture image={photo.image} alt={photo.alt} preset="artwork" sizes={photo.stage} priority={i === 0} />
            <span class="visually-hidden">(apri a schermo intero)</span>
          </a>
        </div>
      ))
    }
  </div>

  {
    many && (
      <ul class="gallery__thumbs" role="list" aria-label="Foto dell’opera">
        {photos.map((photo, i) => (
          <li>
            <a
              class="gallery__thumb"
              href={photo.viewer.full}
              aria-current={i === 0 ? 'true' : undefined}
              data-gallery-thumb={i}
            >
              <ResponsivePicture image={photo.image} alt={photo.alt} preset="thumb" sizes={photo.thumb} />
            </a>
          </li>
        ))}
      </ul>
    )
  }
  {many && <p class="visually-hidden" aria-live="polite" data-gallery-status />}

  <ImageViewer images={viewerImages} label={`Immagini di «${data.titolo}»`} />
</div>

<script>
  // Thumbnails swap the photo on the stage (700 ms crossfade; at once with reduced motion). The
  // stage link of the photo shown is the one that opens the viewer, at that photo.
  const FADE_MS = 700;

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const slides = [...gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]')];
    const thumbs = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-gallery-thumb]')];
    const status = gallery.querySelector<HTMLElement>('[data-gallery-status]');
    if (slides.length < 2) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let cleanup: number | undefined;

    const show = async (index: number) => {
      if (index === current || !slides[index]) return;
      current = index;
      thumbs.forEach((thumb, i) => (i === index ? thumb.setAttribute('aria-current', 'true') : thumb.removeAttribute('aria-current')));
      if (status) status.textContent = `Foto ${index + 1} di ${slides.length}`;

      const next = slides[index];
      next.hidden = false;
      const image = next.querySelector('img');
      if (image) {
        image.loading = 'eager';
        // Fade in only once the photo can be painted (a broken file still swaps).
        await image.decode().catch(() => undefined);
      }
      if (current !== index) return; // another thumbnail was chosen meanwhile

      slides.forEach((slide, i) => {
        slide.classList.toggle('is-current', i === index);
        slide.inert = i !== index;
      });
      window.clearTimeout(cleanup);
      cleanup = window.setTimeout(
        () => slides.forEach((slide, i) => (slide.hidden = i !== current)),
        reduced.matches ? 0 : FADE_MS,
      );
    };

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', (event) => {
        // Modified clicks (new tab, download…) keep the browser's default: the full-size JPEG.
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        show(Number(thumb.dataset.galleryThumb));
      });
    });
  });
</script>

<style>
  .gallery {
    /* Stage height and how much of it the painting may fill (phone: the 440 px box of frame 1g). */
    --stage-h: 440px;
    --fit-w: 1;
    --fit-h: 1;
    --thumb-h: 64px;
  }

  .gallery__stage {
    position: relative;
    isolation: isolate;
    height: var(--stage-h);
  }

  .gallery__stage :global(.gallery__stroke) {
    inset: 20% 20% 6% -10%;
  }

  .gallery__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--tiz-dur-fade) ease;
  }

  .gallery__slide.is-current {
    opacity: 1;
    pointer-events: auto;
  }

  .gallery__slide[hidden] {
    display: none;
  }

  /* The painting, whole: width from the stage, height from the photo. */
  .gallery__frame {
    display: block;
    width: min(calc(var(--fit-w) * 100%), calc(var(--stage-h) * var(--fit-h) * var(--ratio)));
    box-shadow: var(--tiz-shadow-tela);
    cursor: zoom-in;
  }

  .gallery__frame :global(img) {
    width: 100%;
    height: auto;
  }

  .gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--tiz-s3) var(--tiz-s4);
    margin-top: var(--tiz-s4);
  }

  /* At least 44 × 44 to tap, the photo centred in it at its real proportions. */
  .gallery__thumb {
    position: relative;
    display: flex;
    justify-content: center;
    min-width: var(--tiz-hit);
    padding-bottom: var(--tiz-s3);
    color: var(--tiz-terra);
    transition: transform var(--tiz-dur-lift) var(--tiz-ease-settle);
  }

  .gallery__thumb :global(img) {
    width: auto;
    height: var(--thumb-h);
    box-shadow: var(--tiz-shadow-tela);
  }

  /* The photo on the stage: an ocra marker under its thumbnail (never on the painting). */
  .gallery__thumb::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 4px;
    border-radius: 2px 6px 2px 5px;
    background: var(--tiz-ocra);
    opacity: 0;
    transition: opacity var(--tiz-dur-fast) var(--tiz-ease-settle);
  }

  .gallery__thumb[aria-current='true']::after {
    opacity: 1;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .gallery__thumb:hover {
      transform: translateY(calc(var(--tiz-lift) / 2));
    }
  }

  @media (min-width: 640px) {
    .gallery {
      --stage-h: 600px;
      --fit-w: 0.88;
      --fit-h: 0.92;
      --thumb-h: 84px;
    }

    /* Short screens: the painting stays whole in the first screen (never taller than the design). */
    @supports (height: 100svh) {
      .gallery {
        --stage-h: min(600px, max(440px, 100svh - 200px));
      }
    }

    /* The design's inset, relative to the stage; but the stroke always shows at least 64 px left and
       24 px right of the cover (as in frame 1f), also for square and wide works the inset alone would
       hide behind the painting. --frame = the cover's width (see .gallery__frame). */
    .gallery__stage :global(.gallery__stroke) {
      --frame: min(calc(var(--fit-w) * 100%), calc(var(--stage-h) * var(--fit-h) * var(--ratio)));
      inset: 16% 14% 10% 4%;
      left: min(4%, calc((100% - var(--frame)) / 2 - 64px));
      right: min(14%, calc((100% - var(--frame)) / 2 - 24px));
    }
  }

  @media (min-width: 1024px) {
    .gallery {
      --stage-h: 720px;
    }

    /* The large stage of frame 1f: a deeper shadow. */
    .gallery__frame {
      box-shadow: var(--tiz-shadow-tela-l);
    }

    @supports (height: 100svh) {
      .gallery {
        --stage-h: min(720px, max(560px, 100svh - 180px));
      }
    }
  }
</style>
