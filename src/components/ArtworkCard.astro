---
/**
 * One work in a grid: cover (real aspect ratio) + title + "anno · misure", linking to its page.
 * Used inside ArtworkGrid, which sizes the card from `--ratio` (justified rows).
 */
import ResponsivePicture from './ResponsivePicture.astro';
import { routes } from './lib/site';
import { altText, metaParts, type Opera } from './lib/opere';

interface Props {
  opera: Opera;
  /** Heading level of the title, to fit the page outline. */
  headingLevel?: 2 | 3;
  priority?: boolean;
}

const { opera, headingLevel = 3, priority = false } = Astro.props;
const { data } = opera;
const cover = data.immagini[0];
const ratio = cover.width / cover.height;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const meta = metaParts(data);
// Rendered width depends on the row; wide paintings get more room than tall ones.
const sizes = ratio >= 1 ? '(min-width: 80rem) 32vw, (min-width: 48rem) 42vw, 92vw' : '(min-width: 80rem) 20vw, (min-width: 48rem) 28vw, 56vw';
---

<li class="artwork-card" style={`--ratio: ${ratio.toFixed(4)}`}>
  <a class="artwork-card__link" href={routes.opera(opera.id)}>
    <div class="artwork-card__media">
      <ResponsivePicture image={cover} alt={altText(data)} preset="card" sizes={sizes} priority={priority} />
    </div>
    <Heading class="artwork-card__title">{data.titolo}</Heading>
    {
      meta.length > 0 && (
        <p class="artwork-card__meta">
          {meta.map((part, i) => (
            <>
              {i > 0 && ' · '}
              <span class="artwork-card__meta-part">{part}</span>
            </>
          ))}
        </p>
      )
    }
  </a>
</li>

<style>
  .artwork-card {
    /* Justified rows: width proportional to the aspect ratio, so every image in a row has the same height. */
    flex: calc(var(--ratio) * 1000) 1 calc(var(--ratio) * var(--grid-row));
    min-width: 0;
  }

  .artwork-card__link {
    display: block;
    text-decoration: none;
  }

  .artwork-card__media {
    margin-bottom: var(--space-3);
    box-shadow: var(--shadow-art);
    background: var(--color-placeholder);
    transition: transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease);
  }

  .artwork-card__media :global(img) {
    width: 100%;
    height: auto;
  }

  .artwork-card__link:hover .artwork-card__media {
    transform: translateY(-3px);
    box-shadow: var(--shadow-art), 0 18px 32px -20px rgb(29 27 24 / 0.45);
  }

  .artwork-card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .artwork-card__link:hover .artwork-card__title {
    color: var(--color-highlight);
  }

  .artwork-card__meta {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  /* Narrow cards wrap between year and size, never inside "120 × 150 cm". */
  .artwork-card__meta-part {
    white-space: nowrap;
  }
</style>
