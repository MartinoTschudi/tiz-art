---
/**
 * Previous / next work at the bottom of an artwork page (frame 1f; the list wraps around): two halves
 * with a dashed divider, each with an 84 px thumbnail, "← Precedente" / "Successiva →" and the title
 * in her hand; gesso on hover. From 640 px only: on phones the fixed bar (opera/OperaBar.astro) has
 * the arrows.
 */
import ResponsivePicture from './ResponsivePicture.astro';
import { routes } from './lib/site';
import type { Opera } from './lib/opere';
import { pagerThumbSizes } from './lib/opera';

interface Props {
  prev?: Opera;
  next?: Opera;
}

const { prev, next } = Astro.props;
const cover = (opera: Opera) => opera.data.immagini[0];
const sizesOf = (opera: Opera) => pagerThumbSizes(cover(opera).width / cover(opera).height);
---

{
  (prev || next) && (
    <nav class="pager" aria-label="Altre opere">
      <div class="pager__inner">
        {prev && (
          <a class="pager__link pager__link--prev" href={routes.opera(prev.id)} rel="prev">
            <span class="pager__thumb">
              <ResponsivePicture image={cover(prev)} alt="" preset="thumb" sizes={sizesOf(prev)} />
            </span>
            <span class="pager__text">
              <span class="pager__label">
                <span aria-hidden="true">←</span> Precedente
              </span>
              <span class="pager__title">{prev.data.titolo}</span>
            </span>
          </a>
        )}
        {next && (
          <a class="pager__link pager__link--next" href={routes.opera(next.id)} rel="next">
            <span class="pager__text">
              <span class="pager__label">
                Successiva <span aria-hidden="true">→</span>
              </span>
              <span class="pager__title">{next.data.titolo}</span>
            </span>
            <span class="pager__thumb">
              <ResponsivePicture image={cover(next)} alt="" preset="thumb" sizes={sizesOf(next)} />
            </span>
          </a>
        )}
      </div>
    </nav>
  )
}

<style>
  .pager {
    display: none;
    border-top: var(--tiz-divider);
  }

  .pager__inner {
    display: grid;
    /* minmax(0, …): a long title wraps instead of widening its half */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    max-width: var(--tiz-page-max);
    margin-inline: auto;
  }

  .pager__link {
    display: flex;
    align-items: center;
    gap: var(--tiz-s4);
    min-width: 0;
    padding: 28px var(--tiz-gutter);
    color: var(--tiz-terra);
    text-decoration: none;
    transition: background-color var(--tiz-dur-fast) var(--tiz-ease-settle);
  }

  .pager__link:hover {
    background: var(--tiz-gesso);
    color: var(--tiz-terra);
  }

  /* Inside the half: the half reaches the edge of the window. */
  .pager__link:focus-visible {
    outline-offset: calc(-1 * var(--tiz-focus-offset) - 2px);
  }

  .pager__link--prev {
    border-right: var(--tiz-divider);
  }

  .pager__link--next {
    grid-column: 2;
    justify-content: flex-end;
    text-align: right;
  }

  .pager__thumb {
    flex: none;
  }

  .pager__thumb :global(img) {
    width: auto;
    height: 84px;
    box-shadow: var(--tiz-shadow-tela);
  }

  .pager__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .pager__link--next .pager__text {
    align-items: flex-end;
  }

  .pager__label {
    color: var(--tiz-terra-2);
    font: 500 var(--tiz-small) / 1 var(--tiz-font-voce);
  }

  .pager__title {
    font: 400 36px/1 var(--tiz-font-mano);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  @media (min-width: 640px) {
    .pager {
      display: block;
    }
  }
</style>
