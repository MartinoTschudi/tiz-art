---
/**
 * Previous / next work at the bottom of an artwork page (the list wraps around).
 */
import { routes } from './lib/site';
import type { Opera } from './lib/opere';

interface Props {
  prev?: Opera;
  next?: Opera;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="pager" aria-label="Altre opere">
      {prev && (
        <a class="pager__link pager__link--prev" href={routes.opera(prev.id)} rel="prev">
          <span class="pager__label">
            <span aria-hidden="true">←</span> Precedente
          </span>
          <span class="pager__title">{prev.data.titolo}</span>
        </a>
      )}
      {next && (
        <a class="pager__link pager__link--next" href={routes.opera(next.id)} rel="next">
          <span class="pager__label">
            Successiva <span aria-hidden="true">→</span>
          </span>
          <span class="pager__title">{next.data.titolo}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    /* minmax(0, …): a long title wraps instead of widening its column */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--color-line);
  }

  .pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: var(--tap-target);
    text-decoration: none;
  }

  .pager__link--next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }

  .pager__label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .pager__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .pager__link:hover .pager__title {
    color: var(--color-highlight);
  }
</style>
