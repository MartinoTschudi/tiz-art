---
/**
 * Contact form (CONTRACTS 5.4, frames 1j / 1k / 1j-sent), the only way to reach the artist. Behaviour
 * in contact-form.ts; rules and texts in lib/contatti.ts.
 *
 * - With JavaScript: Italian validation (the error under its field, the input kept), JSON POST to
 *   Web3Forms with fetch; "Grazie!" then replaces the form (focus moved to it, announced) and
 *   "Scrivi ancora" brings back an empty form.
 *   `?opera=<slug>` of a published work shows the chip "Mi interessa «…»" with its × (≥ 44 px): the
 *   works are embedded below as JSON, and a tiny inline script draws the chip while the page is parsed,
 *   so it never pushes the fields down after the first paint.
 * - Without JavaScript: a normal POST to Web3Forms with the fields it expects (access_key, subject,
 *   from_name, name, email, message, botcheck, redirect); Web3Forms then sends the visitor to
 *   /contatti/grazie/ (absolute URL, base path included).
 * - Empty access key (src/data/sito.json): the form renders; after validation, sending shows
 *   "Il modulo non è ancora attivo" (the build prints a warning). Without JS that notice shows at once
 *   and the button is off, so nothing is posted to Web3Forms in vain.
 *
 * Hooks for the script: [data-contact] (root), form[data-contact-form] (data-active),
 * script[data-contact-opere], [data-opera-chip] (+ data-slug, [data-opera-thumb], [data-opera-title],
 * [data-opera-clear]), [data-error-for], [data-submit], [data-status] (data-tone, [data-status-title],
 * [data-status-text]), [data-contact-offline], [data-contact-success], [data-grazie-title],
 * [data-contact-again], [data-contact-live].
 */
import Grazie from './contatti/Grazie.astro';
import { SITE, absoluteUrl, routes, withBase } from './lib/site';
import type { Opera } from './lib/opere';
import { CONTACT_THUMB_WIDTH, webpUrl } from './lib/images';
import { FROM_NAME, LIMITS, MESSAGES, MIN_MESSAGE, SUBJECT, WEB3FORMS_ENDPOINT } from './lib/contatti';

interface Props {
  /** Published works, in display order (getPublishedOpere()). */
  opere: Opera[];
  /** id of the heading that names the form ("Scrivimi"). */
  labelledBy?: string;
}

const { opere, labelledBy } = Astro.props;
const active = SITE.web3formsAccessKey !== '';
const redirect = absoluteUrl(withBase('contatti/grazie/'));

// The chip's thumbnail box (CSS px, desktop; CSS scales it down on phones). The painting is fitted
// inside it, never cropped: 64 px high, or narrower when it is very wide.
const THUMB_BOX = { width: 96, height: 64 };

const works = await Promise.all(
  opere.map(async (opera) => {
    const cover = opera.data.immagini[0];
    const ratio = cover.width / cover.height;
    const height = Math.min(THUMB_BOX.height, Math.round(THUMB_BOX.width / ratio));
    return {
      slug: opera.id,
      titolo: opera.data.titolo,
      url: absoluteUrl(routes.opera(opera.id)),
      thumb: await webpUrl(cover, CONTACT_THUMB_WIDTH),
      width: Math.max(1, Math.round(height * ratio)),
      height,
    };
  }),
);
// Inside <script type="application/json">: "<" escaped, so no title can close the element.
const worksJson = JSON.stringify(works).replace(/</g, '\\u003c');
---

<div class="contact" data-contact>
  <form
    class="contact-form"
    method="post"
    action={WEB3FORMS_ENDPOINT}
    aria-labelledby={labelledBy}
    data-contact-form
    data-active={active ? 'true' : 'false'}
  >
    <input type="hidden" name="access_key" value={SITE.web3formsAccessKey} />
    <input type="hidden" name="subject" value={SUBJECT} />
    <input type="hidden" name="from_name" value={FROM_NAME} />
    <input type="hidden" name="redirect" value={redirect} />
    {/* Title + URL of the chosen work; disabled (not sent) while none is chosen. */}
    <input type="hidden" name="opera" value="" disabled />

    <div class="chip" hidden data-opera-chip>
      <span class="chip__thumb" data-opera-thumb></span>
      <p class="chip__text">
        <span class="chip__label">Mi interessa</span>
        <span class="chip__title" data-opera-title></span>
      </p>
      <button class="chip__remove" type="button" aria-label="Rimuovi l’opera dal messaggio" data-opera-clear>
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <script type="application/json" data-contact-opere set:html={worksJson} />
    <script is:inline>
      // Runs while the page is parsed (before the first paint, so the fields never jump): show the chip
      // when ?opera= names a published work (the JSON above). contact-form.ts reads data-slug.
      (function () {
        try {
          var slug = new URLSearchParams(location.search).get('opera');
          var form = document.currentScript && document.currentScript.closest('form');
          if (!slug || !form) return;
          var works = JSON.parse(form.querySelector('[data-contact-opere]').textContent);
          var work = works.filter(function (w) { return w.slug === slug; })[0];
          if (!work) return;
          var chip = form.querySelector('[data-opera-chip]');
          var img = document.createElement('img');
          img.alt = '';
          img.width = work.width;
          img.height = work.height;
          img.decoding = 'async';
          img.src = work.thumb;
          chip.querySelector('[data-opera-thumb]').appendChild(img);
          chip.querySelector('[data-opera-title]').textContent = work.titolo;
          chip.querySelector('[data-opera-clear]').setAttribute('aria-label', 'Rimuovi «' + work.titolo + '» dal messaggio');
          chip.dataset.slug = work.slug;
          chip.hidden = false;
        } catch (error) {
          // No chip: the message simply goes without a work.
        }
      })();
    </script>

    <div class="field">
      <label class="field__label" for="contatto-nome">Il tuo nome</label>
      <input
        class="field__control"
        id="contatto-nome"
        name="name"
        type="text"
        autocomplete="name"
        required
        maxlength={LIMITS.name}
        aria-describedby="contatto-nome-errore"
      />
      <p class="field__error" id="contatto-nome-errore" data-error-for="name"></p>
    </div>

    <div class="field">
      <label class="field__label" for="contatto-email">La tua e-mail, per risponderti</label>
      <input
        class="field__control"
        id="contatto-email"
        name="email"
        type="email"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        required
        maxlength={LIMITS.email}
        aria-describedby="contatto-email-errore"
      />
      <p class="field__error" id="contatto-email-errore" data-error-for="email"></p>
    </div>

    <div class="field">
      <label class="field__label" for="contatto-messaggio">Il tuo messaggio</label>
      <textarea
        class="field__control field__control--area"
        id="contatto-messaggio"
        name="message"
        rows="5"
        required
        minlength={MIN_MESSAGE}
        maxlength={LIMITS.message}
        aria-describedby="contatto-messaggio-errore"></textarea>
      <p class="field__error" id="contatto-messaggio-errore" data-error-for="message"></p>
    </div>

    <div class="actions">
      <button class="tiz-btn actions__submit" type="submit" disabled={!active} data-submit>
        <span>Invia <span aria-hidden="true">→</span></span>
      </button>
      {/* Reserved height: messages appear here without moving anything. */}
      <div class="actions__slot">
        <p class="status" role="status" data-status>
          <strong class="status__title" data-status-title></strong>{' '}
          <span data-status-text></span>
        </p>
        {
          !active && (
            <p class="status status--offline" data-tone="inactive" data-contact-offline>
              <strong class="status__title">{MESSAGES.inactiveTitle}</strong>{' '}
              <span>Per ora i messaggi non partono.</span>
            </p>
          )
        }
      </div>
    </div>

    <p class="privacy">
      Nome, <span class="nowrap">e-mail</span> e messaggio servono solo per risponderti: li ricevo
      per <span class="nowrap">e-mail</span> tramite il servizio Web3Forms, che può trattarli all’estero.
      Non li uso per nient’altro.
    </p>

    {/* Honeypot: invisible to people, bots tend to tick it (Web3Forms rejects the POST then). */}
    <div class="trap" aria-hidden="true">
      <label>Non compilare questo campo <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
    </div>
  </form>

  <div class="success" hidden data-contact-success>
    <Grazie level={2} id="contatto-grazie" focusable>
      <button class="tiz-marker" type="button" data-contact-again>Scrivi ancora</button>
    </Grazie>
  </div>

  <p class="visually-hidden" aria-live="polite" data-contact-live></p>
</div>

<script>
  import { initContactForms } from './contact-form';

  initContactForms();
</script>

<style>
  /* ── Form: one column. The reserved error line under each field is part of the spacing, so the
     fields sit about 30 px apart as in the frames, with or without an error. ── */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact-form[hidden],
  .chip[hidden],
  .success[hidden] {
    display: none;
  }

  /* ── Chip "Mi interessa «…»" ── */
  .chip {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
    padding: 10px;
    border-radius: var(--tiz-radius-btn);
    background: var(--tiz-gesso);
  }

  .chip__thumb {
    flex: none;
    display: flex;
  }

  /* The painting whole, inside the box (never cropped); the only effect is its shadow. */
  .chip__thumb :global(img) {
    width: auto;
    height: auto;
    max-width: 84px;
    max-height: 56px;
    box-shadow: var(--tiz-shadow-tela);
  }

  .chip__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .chip__label {
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    color: var(--tiz-terra-2);
  }

  /* A very long title (up to 120 characters) stops after 4 lines; the whole title stays in the text. */
  .chip__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
    font-family: var(--tiz-font-mano);
    font-size: 28px;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .chip__remove {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--tiz-hit);
    height: var(--tiz-hit);
    padding: 0;
    border: 0;
    border-radius: var(--tiz-radius-btn-s);
    background: transparent;
    color: var(--tiz-terra);
    font: 500 22px/1 var(--tiz-font-voce);
    transition: background-color var(--tiz-dur-fast) var(--tiz-ease-settle);
  }

  .chip__remove:hover {
    background: var(--tiz-lino);
    color: var(--tiz-rosso);
  }

  /* ── Fields with the underline ── */
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field__label {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--tiz-terra-2);
    transition: color var(--tiz-dur-fast) var(--tiz-ease-settle);
  }

  .field:focus-within .field__label {
    color: var(--tiz-terra);
  }

  .field__control {
    width: 100%;
    min-height: var(--tiz-hit);
    padding: 10px 0;
    border: 0;
    border-bottom: 2px solid var(--tiz-terra);
    border-radius: 0;
    background: transparent;
    color: var(--tiz-terra);
    font: 400 20px/1.2 var(--tiz-font-voce);
    appearance: none;
    transition:
      border-color var(--tiz-dur-fast) var(--tiz-ease-settle),
      box-shadow var(--tiz-dur-fast) var(--tiz-ease-settle);
  }

  .field__control--area {
    display: block;
    line-height: 1.45;
    resize: vertical;
  }

  /* Focus: the underline turns rosso and doubles (the transparent outline shows in forced colours). */
  .field__control:focus-visible {
    outline: 2px solid transparent;
    outline-offset: 2px;
    border-bottom-color: var(--tiz-rosso);
    box-shadow: 0 2px 0 var(--tiz-rosso);
  }

  .field__control[aria-invalid='true'] {
    border-bottom-color: var(--tiz-error);
  }

  /* Browser autofill keeps the underline look (no coloured box). */
  .field__control:-webkit-autofill {
    -webkit-text-fill-color: var(--tiz-terra);
    transition: background-color 600000s 0s;
  }

  /* Reserved line: an error appearing does not push the form around. */
  .field__error {
    min-height: calc(14px * 1.4);
    margin-top: -2px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--tiz-error);
  }

  /* ── Send ── */
  .actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    margin-top: 2px;
  }

  .actions__submit {
    height: 56px;
    padding: 0 30px;
  }

  /* Off only without JS while the form is not active (the note under it says why). */
  .actions__submit:disabled {
    cursor: not-allowed;
  }

  .actions__slot {
    min-height: 68px;
  }

  .status {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.45;
  }

  .status__title {
    display: block;
    font-weight: 700;
  }

  .status__title:empty {
    display: none;
  }

  .status[data-tone='busy'] {
    color: var(--tiz-terra-2);
  }

  .status[data-tone='error'],
  .status[data-tone='failure'] {
    color: var(--tiz-error);
  }

  /* Not active yet: a quiet gesso note, not an error (nothing the visitor did wrong). */
  .status[data-tone='inactive'] {
    padding: 10px 14px;
    border-radius: var(--tiz-radius-btn);
    background: var(--tiz-gesso);
    color: var(--tiz-terra-3);
    font-weight: 400;
  }

  .status[data-tone='inactive'] .status__title {
    color: var(--tiz-terra);
  }

  /* The no-JS notice: with the script, the same note appears only after "Invia". */
  :global(.js) .status--offline {
    display: none;
  }

  .nowrap {
    white-space: nowrap;
  }

  .privacy {
    margin-top: 6px;
    max-width: 34em;
    font-size: 14px;
    line-height: 1.45;
    color: var(--tiz-terra-2);
  }

  .trap {
    position: absolute;
    left: -100vw;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .contact-form {
      gap: 8px;
    }

    .chip {
      gap: 16px;
      margin-bottom: 22px;
      padding: 12px;
    }

    .chip__thumb :global(img) {
      max-width: 96px;
      max-height: 64px;
    }

    .chip__title {
      font-size: 30px;
    }

    .field__control {
      font-size: 22px;
    }

    .actions {
      align-items: flex-start;
    }

    .actions__slot {
      align-self: stretch;
      min-height: 64px;
    }
  }

  @media (min-width: 1024px) {
    .contact-form {
      padding-top: 24px;
    }
  }
</style>
