---
/**
 * Home series section (frames 1b / 1c): the series title in Bricolage 800 with its year in her hand,
 * the series line from SERIE_NOTE (lib/site.ts), up to 5 of its works hung by eye (HungWorks) and
 * the link to all works. `series` comes from lib/composition.ts → pickSeries; without a series
 * (name null) the section is "Le ultime opere". Nothing is rendered when there is no work to show.
 */
import HungWorks from '../HungWorks.astro';
import { SERIE_NOTE, routes } from '../lib/site';
import type { ComposableOpera } from '../lib/opere';
import { isLongTitle, type Series } from '../lib/composition';
import { allWorksLabel } from '../lib/home';

interface Props {
  series: Series<ComposableOpera>;
  /** Number of published works (for "Tutte le {n} opere"). */
  total: number;
}

const { series, total } = Astro.props;
const title = series.name ?? 'Le ultime opere';
// A series name over 40 characters (up to 120 are allowed) gets the next smaller size.
const long = isLongTitle(title);
const note = series.name ? SERIE_NOTE[series.name] : undefined;
---

{
  series.works.length > 0 && (
    <section class="home-series" aria-labelledby="home-serie">
      <div class="container">
        <header class="home-series__head">
          <h2 class:list={['home-series__title', long && 'home-series__title--long']} id="home-serie">
            {title}
            {series.name && series.year && (
              <>
                {' '}
                <span class="home-series__year">{series.year}</span>
              </>
            )}
          </h2>
          {note && <p class="home-series__note">{note}</p>}
        </header>
        <div class="home-series__works">
          <HungWorks opere={series.works.map((work) => work.opera)} headingLevel={3} showSize={false} />
        </div>
        <p class="home-series__more">
          <a class="tiz-marker" href={routes.opere}>
            {allWorksLabel(total)} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  .home-series__head {
    padding-top: 72px;
  }

  .home-series__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
    /* 64px; a little smaller on very narrow phones so "noi, DONNA." stays on one line. */
    font: 800 min(64px, 16.4vw) / 0.9 var(--tiz-font-voce);
    letter-spacing: -0.04em;
    text-wrap: balance;
    /* A series name of one long word breaks instead of pushing the page sideways (the name is a
       flex item, where break-word does not help). */
    overflow-wrap: anywhere;
  }

  .home-series__title--long {
    font-size: min(48px, 12vw);
  }

  .home-series__year {
    /* Phone: a line of its own, tilted around its middle as in frame 1c. */
    align-self: stretch;
    color: var(--tiz-terracotta);
    font: 400 36px/1 var(--tiz-font-mano);
    letter-spacing: 0;
    transform: rotate(-3deg);
  }

  .home-series__note {
    max-width: 340px;
    margin-top: var(--tiz-s4);
    color: var(--tiz-terra-3);
    font-size: var(--tiz-body);
    line-height: 1.5;
  }

  /* Home captions show the title only (showSize={false}, frames 1b / 1c); the works hang a little
     closer than on Opere. */
  .home-series__works {
    --hung-gap: var(--tiz-s6);
    --hung-gap-row: 40px;
    --hung-gap-col: var(--tiz-s6);
    padding-block: 36px 24px;
  }

  .home-series__more {
    padding-block: var(--tiz-s2) 64px;
  }

  @media (min-width: 640px) {
    .home-series__head {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px 40px;
      /* 40 + the 40 above the works = the 80 px of frame 1b between title and works. */
      padding-block: var(--tiz-s7) 40px;
    }

    .home-series__title {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 24px;
      font-size: clamp(64px, 10vw, 128px);
      line-height: 0.85;
    }

    .home-series__title--long {
      font-size: clamp(48px, 6.5vw, 84px);
    }

    .home-series__year {
      align-self: auto;
      font-size: 56px;
      transform: rotate(-4deg);
    }

    .home-series__note {
      margin: 0 0 var(--tiz-s3);
      font-size: 19px;
    }

    .home-series__works {
      padding-block: 40px;
    }

    .home-series__more {
      display: flex;
      justify-content: center;
      padding-block: 24px 96px;
    }

    .home-series__more .tiz-marker {
      padding-inline: var(--tiz-s1);
      font-size: 19px;
    }
  }
</style>
