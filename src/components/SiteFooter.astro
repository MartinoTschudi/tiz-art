---
/**
 * Site footer.
 * - default: dashed filo top border, her signature (Firma, 40px high, rosso) and
 *   "© {year} Tiziana Tschudi Belloli".
 * - variant="home": the signature 96px high with the motto, and the nav on the right ("Scrivimi" in
 *   place of Contatti) above the © line. On phones (frame 1c) only the signature (76px) and the © line.
 * By design there is no address, phone, e-mail or social link anywhere on the site (CONTRACTS 5.1).
 */
import sito from '../data/sito.json';
import Firma from './Firma.astro';
import { SITE, routes } from './lib/site';
import { getProfilo } from './lib/opere';

interface Props {
  variant?: 'default' | 'home';
}

const { variant = 'default' } = Astro.props;
const year = new Date().getFullYear();
const home = variant === 'home';
const motto = home ? (await getProfilo()).motto.trim() : '';
const domain = new URL(sito.dominio).host;
---

{
  home ? (
    <footer class="tiz-footer tiz-footer--home">
      <div class="tiz-footer__inner container">
        <div class="tiz-footer__sign">
          <Firma class="tiz-footer__tiz" />
          {motto && <p class="tiz-footer__motto">{motto}</p>}
        </div>
        <div class="tiz-footer__end">
          <nav class="tiz-footer__nav" aria-label="Piè di pagina">
            <ul role="list">
              <li>
                <a href={routes.opere}>Opere</a>
              </li>
              <li>
                <a href={routes.chiSono}>Chi sono</a>
              </li>
              <li>
                <a href={routes.contatti}>Scrivimi</a>
              </li>
            </ul>
          </nav>
          <p class="tiz-footer__copy">
            © {year} {SITE.nome} · {domain}
          </p>
        </div>
      </div>
    </footer>
  ) : (
    <footer class="tiz-footer">
      <div class="tiz-footer__inner container">
        <Firma class="tiz-footer__tiz" />
        <p class="tiz-footer__copy">
          © {year} {SITE.nome}
        </p>
      </div>
    </footer>
  )
}

<style>
  .tiz-footer {
    border-top: var(--tiz-divider);
  }

  .tiz-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--tiz-s2) var(--tiz-s4);
    padding-block: 28px;
  }

  .tiz-footer__tiz {
    height: 40px;
    color: var(--tiz-rosso);
  }

  .tiz-footer__copy {
    color: var(--tiz-terra-2);
    font-size: var(--tiz-small);
    line-height: var(--tiz-line-small);
  }

  @media (min-width: 640px) {
    .tiz-footer__inner {
      padding-block: 36px;
    }

    .tiz-footer__copy {
      line-height: 1;
    }
  }

  /* ── Home ──────────────────────────────────────────────── */
  .tiz-footer--home {
    border-top: 0;
  }

  .tiz-footer--home .tiz-footer__inner {
    display: block;
    padding-block: var(--tiz-s6) 36px;
  }

  .tiz-footer--home .tiz-footer__tiz {
    height: 76px;
  }

  .tiz-footer__motto,
  .tiz-footer__nav {
    display: none;
  }

  .tiz-footer--home .tiz-footer__copy {
    margin-top: 16px;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .tiz-footer--home .tiz-footer__inner {
      display: flex;
      align-items: flex-end;
      gap: 40px;
      padding-block: 64px 40px;
    }

    .tiz-footer--home .tiz-footer__tiz {
      height: 96px;
    }

    .tiz-footer__motto {
      display: block;
      margin-top: var(--tiz-s3);
      font: 400 30px/1 var(--tiz-font-mano);
    }

    .tiz-footer__end {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 7px; /* + the 7px under the last link = the design's 14px */
      margin-left: auto;
    }

    .tiz-footer__nav {
      display: block;
    }

    .tiz-footer__nav ul {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }

    /* 31 px apart as in the design (17px text + 14px gap); 44 px targets wherever touch is possible. */
    .tiz-footer__nav a {
      display: inline-flex;
      align-items: center;
      min-height: 31px;
      color: var(--tiz-terra);
      font: 500 var(--tiz-body)/1 var(--tiz-font-voce);
      text-decoration: none;
    }

    .tiz-footer__nav a:hover {
      color: var(--tiz-rosso);
    }

    .tiz-footer--home .tiz-footer__copy {
      margin-top: 0;
      line-height: 1;
    }
  }

  @media (min-width: 640px) and (any-pointer: coarse) {
    .tiz-footer__nav a {
      min-height: var(--tiz-hit);
    }
  }
</style>
