---
/**
 * Responsive photo (paintings, portrait): <picture> with AVIF sources and a WebP <img>, widths from a
 * preset in lib/images.ts. Width/height attributes keep the real aspect ratio (no layout shift, never
 * cropped).
 * Unstyled on purpose: the parent styles it, e.g. `.tiz-hung__media :global(img) { width: 100% }`.
 * `sizes` comes from the layout width (e.g. lib/composition.ts → realScaleSizes for the real-scale lists).
 *
 *   <ResponsivePicture image={cover} alt="…" preset="card" sizes={realScaleSizes(data.larghezza)} />
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { FALLBACK_WIDTH, WIDTHS } from './lib/images';

interface Props {
  image: ImageMetadata;
  alt: string;
  preset: 'card' | 'artwork' | 'thumb';
  sizes: string;
  /** Above the fold: load eagerly with high priority (the largest image of the first screen). */
  priority?: boolean;
}

const { image, alt, preset, sizes, priority = false, ...rest } = Astro.props;
const width = Math.min(FALLBACK_WIDTH, image.width);
const height = Math.round((image.height * width) / image.width);
---

<Picture
  src={image}
  alt={alt}
  formats={['avif']}
  fallbackFormat="webp"
  widths={[...WIDTHS[preset]]}
  sizes={sizes}
  width={width}
  height={height}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
  {...rest}
/>
