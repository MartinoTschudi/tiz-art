---
/**
 * The facts of a work as a definition list: Anno, Misure, Tecnica (empty ones are skipped; the series
 * is in the counter line above the title).
 *
 * - ≥ 640 px (frame 1f): two columns, the terms in terra-2, 16 px.
 * - < 640 px (frame 1g): "2023 · 120 × 150 cm" and the technique on its own line, 15 px; the terms are
 *   kept for screen readers only.
 */
import { formatDimensions, type Opera } from './lib/opere';

interface Props {
  data: Opera['data'];
}

const { data } = Astro.props;
const anno = data.anno ? String(data.anno) : '';
const facts = [
  { key: 'anno', term: 'Anno', value: anno },
  { key: 'misure', term: 'Misure', value: formatDimensions(data) ?? '' },
  { key: 'tecnica', term: 'Tecnica', value: data.tecnica.trim() },
].filter(({ value }) => value !== '');
---

{
  facts.length > 0 && (
    <dl class="facts">
      {facts.map(({ key, term, value }) => (
        <>
          <dt class="facts__term">{term}</dt>
          <dd class:list={['facts__value', `facts__value--${key}`]}>
            {key === 'misure' && anno && (
              <span class="facts__sep" aria-hidden="true">
                {' · '}
              </span>
            )}
            {value}
          </dd>
        </>
      ))}
    </dl>
  )
}

<style>
  .facts {
    color: var(--tiz-terra-3);
    font-size: 15px;
    line-height: 1.5;
  }

  /* Phone: one line "anno · misure", then the technique. */
  .facts__term {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .facts__value {
    display: inline;
    margin: 0;
  }

  .facts__value--tecnica {
    display: block;
  }

  @media (min-width: 640px) {
    .facts {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--tiz-s2) var(--tiz-s4);
      color: var(--tiz-terra);
      font-size: 16px;
      line-height: 1.4;
    }

    .facts__term {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
      color: var(--tiz-terra-2);
    }

    .facts__value {
      display: block;
    }

    .facts__sep {
      display: none;
    }
  }
</style>
