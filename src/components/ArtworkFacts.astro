---
/**
 * The facts of a work as a definition list: Anno, Misure, Tecnica, Collezione (empty ones are skipped).
 */
import { formatDimensions, type Opera } from './lib/opere';

interface Props {
  data: Opera['data'];
}

const { data } = Astro.props;
const facts = [
  { term: 'Anno', value: data.anno ? String(data.anno) : '' },
  { term: 'Misure', value: formatDimensions(data) ?? '' },
  { term: 'Tecnica', value: data.tecnica },
  { term: 'Collezione', value: data.collezione },
].filter(({ value }) => value.trim() !== '');
---

{
  facts.length > 0 && (
    <dl class="facts">
      {facts.map(({ term, value }) => (
        <div class="facts__row">
          <dt class="facts__term">{term}</dt>
          <dd class="facts__value">{value}</dd>
        </div>
      ))}
    </dl>
  )
}

<style>
  .facts {
    border-top: var(--border-width) solid var(--color-line);
  }

  .facts__row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-line);
  }

  .facts__term {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-top: 0.2em;
  }

  .facts__value {
    margin: 0;
  }
</style>
