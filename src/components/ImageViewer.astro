---
/**
 * Full-screen viewer (<dialog>) for the photos of one work. Behaviour: image-viewer.ts.
 * Must sit inside the element with `data-viewer-gallery` that holds the `[data-viewer-open]` links.
 *
 * Look («Lo studio»): the lino ground, the painting whole in the middle with its shadow, round
 * 48 px buttons with a terra border (+ / − zoom, × close; ← → and the counter "1 / 3" below when there
 * are several photos), the counter in the voice font. Arrows and × are text characters, as in the
 * design. Hooks (keep them): data-viewer-stage, -image, -zoom, -close, -announcer; optional -prev,
 * -next, -counter; state classes .is-zoomed and .is-dragging on the dialog.
 */
import type { ViewerSource } from './lib/images';

interface Props {
  images: (ViewerSource & { alt: string })[];
  /** Accessible name of the dialog, e.g. "Immagini di «Sorellanza»". */
  label: string;
}

const { images, label } = Astro.props;
const many = images.length > 1;
---

<dialog class="viewer" aria-label={label} data-viewer data-images={JSON.stringify(images)}>
  <div class="viewer__bar viewer__bar--top">
    <button class="tiz-btn tiz-btn--round viewer__button viewer__button--zoom" type="button" aria-pressed="false" data-viewer-zoom>
      <span class="viewer__zoom-in" aria-hidden="true">+</span>
      <span class="viewer__zoom-out" aria-hidden="true">−</span>
      <span class="visually-hidden">Ingrandisci</span>
    </button>
    <button class="tiz-btn tiz-btn--round viewer__button viewer__button--close" type="button" autofocus data-viewer-close>
      <span aria-hidden="true">×</span>
      <span class="visually-hidden">Chiudi</span>
    </button>
  </div>

  <div class="viewer__stage" data-viewer-stage>
    <img class="viewer__image" alt="" draggable="false" data-viewer-image />
  </div>

  {
    many && (
      <div class="viewer__bar viewer__bar--bottom">
        <button class="tiz-btn tiz-btn--round viewer__button" type="button" data-viewer-prev>
          <span aria-hidden="true">←</span>
          <span class="visually-hidden">Immagine precedente</span>
        </button>
        <p class="viewer__counter" aria-hidden="true" data-viewer-counter />
        <button class="tiz-btn tiz-btn--round viewer__button" type="button" data-viewer-next>
          <span aria-hidden="true">→</span>
          <span class="visually-hidden">Immagine successiva</span>
        </button>
      </div>
    )
  }
  <p class="visually-hidden" aria-live="polite" data-viewer-announcer></p>
</dialog>

<script>
  import { initImageViewers } from './image-viewer';

  initImageViewers();
</script>

<style>
  .viewer {
    /* Height of a bar of buttons: the 48 px button + its padding. */
    --viewer-bar: calc(48px + 2 * var(--tiz-s3));

    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: var(--tiz-linen), var(--tiz-viewer-bg);
    color: var(--tiz-terra);
    touch-action: none; /* gestures are handled by the script */
    user-select: none;
    -webkit-user-select: none;
  }

  .viewer::backdrop {
    background: var(--tiz-viewer-bg);
  }

  .viewer__stage {
    position: absolute;
    inset: var(--viewer-bar) max(var(--tiz-gutter), env(safe-area-inset-right)) var(--viewer-bar)
      max(var(--tiz-gutter), env(safe-area-inset-left));
    display: grid;
    place-items: center;
  }

  /* Whole and unfiltered; only the shadow of the design. The script sets its size. */
  .viewer__image {
    max-width: none;
    box-shadow: var(--tiz-shadow-tela);
    transform-origin: center;
    transition: transform var(--tiz-dur-fast) var(--tiz-ease-settle);
    cursor: zoom-in;
    -webkit-user-drag: none;
  }

  .viewer.is-zoomed .viewer__image {
    cursor: grab;
  }

  .viewer.is-dragging .viewer__image {
    transition: none;
  }

  .viewer__bar {
    position: absolute;
    inset-inline: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--tiz-s3);
    padding: var(--tiz-s3) max(var(--tiz-gutter), env(safe-area-inset-right)) var(--tiz-s3)
      max(var(--tiz-gutter), env(safe-area-inset-left));
  }

  .viewer__bar--top {
    top: 0;
    justify-content: flex-end;
    padding-top: max(var(--tiz-s3), env(safe-area-inset-top));
  }

  .viewer__bar--bottom {
    bottom: 0;
    justify-content: center;
    padding-bottom: max(var(--tiz-s3), env(safe-area-inset-bottom));
  }

  /* Over a zoomed painting the buttons stay readable: a lino disc. */
  .viewer__button {
    background: var(--tiz-lino);
    font-size: 24px;
  }

  .viewer__button:hover {
    background: var(--tiz-gesso);
  }

  .viewer__button--zoom,
  .viewer__button--close {
    font-size: 30px;
  }

  /* Readable over a zoomed painting. */
  .viewer.is-zoomed .viewer__counter {
    background: var(--tiz-lino);
  }

  .viewer__zoom-out,
  .viewer__button[aria-pressed='true'] .viewer__zoom-in {
    display: none;
  }

  .viewer__button[aria-pressed='true'] .viewer__zoom-out {
    display: inline;
  }

  .viewer__counter {
    min-width: 4.5em;
    padding: var(--tiz-s2) var(--tiz-s3);
    border-radius: var(--tiz-radius-btn-s);
    color: var(--tiz-terra-2);
    font: 500 15px/1 var(--tiz-font-voce);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
</style>
