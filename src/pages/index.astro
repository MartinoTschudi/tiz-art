---
/**
 * Home (frames 1b / 1c, CONTRACTS §5.1): the hero (motto + the hero works), the series section, the
 * quote band and the large home footer. Which works go where is decided by the composition rules
 * (lib/composition.ts): heroSlots → pickQuote (outside the hero) → pickSeries (outside both).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeQuote from '../components/home/HomeQuote.astro';
import HomeSeries from '../components/home/HomeSeries.astro';
import { SITE } from '../components/lib/site';
import { composable, excerpt, getProfilo, getPublishedOpere } from '../components/lib/opere';
import { heroSlots, pickQuote, pickSeries } from '../components/lib/composition';
import { personJsonLd } from '../components/lib/structured-data';

const [published, profilo] = await Promise.all([getPublishedOpere(), getProfilo()]);
const works = composable(published);
const hero = heroSlots(works);
const heroIds = hero.picked.map((work) => work.id);
const quote = pickQuote(works, heroIds);
const quoteOpera = quote ? published.find((opera) => opera.id === quote.id) : undefined;
// Hero ids first: the series is the one of the first hero work.
const series = pickSeries(works, [...heroIds, ...(quote ? [quote.id] : [])]);
// Which sections follow the hero (HomeSeries renders nothing without works): spacing between them.
const hasSeries = series.works.length > 0;
const hasQuote = Boolean(quote && quoteOpera);

// Motto and bio may both be empty (the admin allows it): never an empty meta description.
const description = excerpt([profilo.motto, profilo.bio].filter(Boolean).join(' ') || `${SITE.nome} (${SITE.firma}), pittrice: opere su tela.`);
---

<BaseLayout description={description} path="" jsonLd={[personJsonLd({ description: profilo.motto || undefined })]} footerVariant="home">
  <HomeHero hero={hero} motto={profilo.motto} alone={!hasSeries && !hasQuote} />
  <HomeSeries series={series} total={published.length} />
  {quote && quoteOpera && <HomeQuote quote={quote} opera={quoteOpera} afterHero={!hasSeries} />}
</BaseLayout>
