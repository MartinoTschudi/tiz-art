---
/**
 * 404 page (dist/404.html; GitHub Pages serves it for any unknown URL, so every link is absolute
 * with the base path).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { routes } from '../components/lib/site';
---

<BaseLayout title="Pagina non trovata" description="Questa pagina non esiste o è stata spostata." path={null} noindex>
  <div class="container">
    <PageHeader
      eyebrow="Errore 404"
      title="Pagina non trovata"
      lead="La pagina che cerchi non esiste o è stata spostata."
    />
    <p class="not-found__links">
      <a class="button" href={routes.opere}>Vedi le opere</a>
      <a class="button button--quiet" href={routes.home}>Torna alla home</a>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
