---
/**
 * Design kit (frame 1a): the shared pieces of the redesign on one page, for the page agents and the
 * reviewers — type scale, colours, buttons, marker links, strokes, header (both states), footer
 * (both variants), HungWorks with all works and with 3, and what the composition rules pick from
 * the real content.
 *
 * TEMPORARY: noindex, out of the sitemap (astro.config.mjs) and not linked from anywhere. Delete
 * src/pages/kit/ (and its line in astro.config.mjs) at the end of the redesign.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HungWorks from '../../components/HungWorks.astro';
import ResponsivePicture from '../../components/ResponsivePicture.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Stroke from '../../components/Stroke.astro';
import { SERIE_NOTE, routes, withBase } from '../../components/lib/site';
import { altText, composable, getProfilo, getPublishedOpere, operaPaint } from '../../components/lib/opere';
import { PAINTS, heroSlots, mottoParts, paintVar, pickQuote, pickSeries, realScaleSizes, splitLastWord, strokeAt } from '../../components/lib/composition';

const [published, profilo] = await Promise.all([getPublishedOpere(), getProfilo()]);
const THREE = ['estasi', 'e-fuori-piove', 'guardami'];
const three = THREE.map((slug) => published.find((opera) => opera.id === slug)).filter((opera) => opera !== undefined);

const works = composable(published);
const hero = heroSlots(works);
const heroIds = hero.picked.map((work) => work.id);
const quote = pickQuote(works, heroIds);
const series = pickSeries(works, [...heroIds, ...(quote ? [quote.id] : [])]);
const motto = mottoParts(profilo.motto);
const mottoFull = splitLastWord(profilo.motto);

const SWATCHES = [
  { name: 'lino', token: '--tiz-lino', hex: '#f3ecdf', use: 'Fondo di tutto il sito: tela grezza con trama leggera.', light: true },
  { name: 'gesso', token: '--tiz-gesso', hex: '#e9dfcd', use: 'Fasce e superfici secondarie, hover.', light: true },
  { name: 'terra', token: '--tiz-terra', hex: '#2a1c15', use: 'Testo e bottoni scuri. Mai nero puro.' },
  { name: 'terra chiara', token: '--tiz-terra-2', hex: '#6b5546', use: 'Didascalie, misure, testo secondario (6:1 su lino).' },
  { name: 'rosso labbra', token: '--tiz-rosso', hex: '#c3262b', use: 'Firma TIZ, «cuore», azione principale.' },
  { name: 'ocra', token: '--tiz-ocra', hex: '#d6982b', use: 'Pennellate, sottolineature a pennarello.' },
  { name: 'terracotta', token: '--tiz-terracotta', hex: '#b5532f', use: 'Note a mano, pennellate calde.' },
  { name: 'ottanio', token: '--tiz-ottanio', hex: '#1d7377', use: 'Contrappunto freddo: Contatti, pennellate.' },
  { name: 'blu', token: '--tiz-blu', hex: '#2c55a0', use: 'Contrappunto freddo, pennellate.' },
  { name: 'filo', token: '--tiz-filo', hex: '#cdbfa9', use: 'Linee tratteggiate, bordi leggeri.', light: true },
];

const TYPE = [
  { token: '--tiz-mano-xl', spec: 'TIZ Mano 92–150 / .82', cls: 't-mano-xl', sample: 'Dialogo tra' },
  { token: '--tiz-mano-l', spec: 'TIZ Mano 64–92 / .88', cls: 't-mano-l', sample: 'Sorellanza' },
  { token: '--tiz-mano-m', spec: 'TIZ Mano 40–76 / 1', cls: 't-mano-m', sample: '«…un’altra: alleanza.»' },
  { token: '--tiz-mano-s', spec: 'TIZ Mano 28–34 / 1', cls: 't-mano-s', sample: 'Guardami!, 2023' },
  { token: '--tiz-mano-caption', spec: 'TIZ Mano 30 / 32 · 1', cls: 't-mano-caption', sample: 'Il coraggio di guardare oltre' },
  { token: '--tiz-display', spec: 'Bricolage 800 · 64–150 / .8 · −0.05em', cls: 't-display', sample: 'noi, DONNA.' },
  { token: '--tiz-h1-name', spec: 'Bricolage 800 · 52–88 · −0.04em', cls: 't-name', sample: 'Tiziana Tschudi Belloli' },
  { token: '--tiz-lead', spec: 'Bricolage 400 · 19–22 / 1.5', cls: 't-lead', sample: 'Come un albero al risveglio del sole, il corpo s’illumina.' },
  { token: '--tiz-body', spec: 'Bricolage 400 · 17 / 1.55', cls: 't-body', sample: 'Volti e corpi di donna, in acrilico e olio, a strati spessi.' },
  { token: '--tiz-small', spec: 'Bricolage 400 · 14 / 1.4', cls: 't-small', sample: '2023 · 120 × 150 cm · acrilico su tela' },
];

const SPACES = [4, 8, 12, 20, 32, 48, 80, 120];
const strokeSamples = published.slice(0, 4);
---

<BaseLayout title="Kit" description="Kit del design di tiz-art.ch (pagina interna)." path={null} noindex>
  <div class="kit container">
    <div class="kit-intro">
      <div>
        <p class="kit-mono">Sistema · v2 · kit per le pagine (interno, da eliminare a fine redesign)</p>
        <h1 class="kit-tiz tiz-write">TIZ <span class="visually-hidden">— kit del design</span></h1>
      </div>
      <p class="kit-lead">
        Tela grezza, colore puro, gesto libero. Il sito si comporta come lo studio: luce chiara, pennelli in giro, i quadri al
        centro.
      </p>
    </div>

    <section class="kit-section" aria-labelledby="k-colori">
      <h2 class="kit-label" id="k-colori">colori</h2>
      <ul class="kit-swatches" role="list">
        {
          SWATCHES.map((s) => (
            <li class="kit-swatch">
              <div class="kit-swatch__paint">
                <Stroke color={`var(${s.token})`} inset="6px" rotate="0deg" class={s.light ? 'kit-swatch__light' : undefined} />
              </div>
              <p class="kit-swatch__name">{s.name}</p>
              <p class="kit-mono">
                {s.hex} · {s.token}
              </p>
              <p class="kit-note">{s.use}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="kit-section" aria-labelledby="k-tipo">
      <h2 class="kit-label" id="k-tipo">tipografia</h2>
      <div class="kit-type">
        <div class="kit-type__pair">
          <div>
            <p class="kit-mono kit-mono--warm">TIZ Mano — la mano</p>
            <p class="kit-type__mano">Dialogo tra testa e <span class="kit-rosso">cuore</span>.</p>
            <p class="kit-note">Solo titoli di opere, motto, firma, piccole note. Mai sotto i 28 px.</p>
          </div>
          <div>
            <p class="kit-mono kit-mono--warm">Bricolage Grotesque — la voce</p>
            <p class="t-lead">
              Acrilico e olio su tela, 120 × 150 cm, 2023. Calda, leggermente irregolare, leggibile anche piccola sul telefono.
            </p>
          </div>
        </div>
        {
          TYPE.map((t) => (
            <div class="kit-type__row">
              <p class="kit-mono">
                {t.token}
                <br />
                {t.spec}
              </p>
              <p class={t.cls}>{t.sample}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="kit-section kit-section--3" aria-labelledby="k-spazio">
      <h2 class="kit-label" id="k-spazio">spazio</h2>
      <ul class="kit-spaces" role="list">
        {
          SPACES.map((px, i) => (
            <li>
              <span class="kit-mono">--tiz-s{i + 1}</span>
              <span class="kit-spaces__bar" style={`width: var(--tiz-s${i + 1})`} />
              <span class="kit-mono">{px}px</span>
            </li>
          ))
        }
      </ul>
      <div class="kit-rules">
        <p><b>Breakpoint:</b> telefono &lt; 640 · tablet 640–1023 · desktop ≥ 1024. Margini (--tiz-gutter) 20 / 32 / 48 px.</p>
        <p>
          <b>Scala reale:</b> larghezza tela = cm × k (--tiz-k = 2,2 telefono · 2,0 tablet · 2,3 desktop, max 100%). L’altezza segue
          la foto: mai deformata, mai tagliata.
        </p>
        <p><b>Appendere a occhio:</b> flex-wrap + margin-top dal ciclo [0, 140, 60, 200, 20, 110, 40, 170]. Telefono: a sinistra / destra / centro a turno.</p>
        <p><b>Pennellata:</b> il colore dell’opera (campo «colore», o automatico). Una opera su due la riceve nella lista.</p>
        <p><b>Altri token:</b> --tiz-hit 44px · --tiz-header-h 80 / 92 / 100 · --tiz-bar-h 88px · --tiz-page-max 1440px · --tiz-measure 620px · --tiz-focus 2px rosso, offset 3px.</p>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="k-moto">
      <h2 class="kit-label" id="k-moto">movimento</h2>
      <div>
        <ul class="kit-motion" role="list" data-kit-replay-area>
          <li>
            <div class="kit-motion__stage">
              <Stroke color="var(--tiz-rosso)" top="22%" left="14%" width="76%" height="60%" rotate="-4deg" />
            </div>
            <p class="kit-swatch__name">pennellata</p>
            <p class="kit-mono">--tiz-dur-stroke · 1100ms · --tiz-ease-brush</p>
            <p class="kit-note">Il colore si stende da sinistra a destra. &lt;Stroke&gt;</p>
          </li>
          <li>
            <div class="kit-motion__stage">
              <span class="kit-motion__write tiz-write">testa e <span class="kit-rosso">cuore</span></span>
            </div>
            <p class="kit-swatch__name">scrittura</p>
            <p class="kit-mono">--tiz-dur-write · 1200ms · .tiz-write</p>
            <p class="kit-note">Le parole a pennello si scrivono una volta, all’arrivo.</p>
          </li>
          <li>
            <div class="kit-motion__stage">
              {
                published[0] && (
                  <div class="kit-motion__settle tiz-settle">
                    <ResponsivePicture image={published[0].data.immagini[0]} alt={altText(published[0].data)} preset="thumb" sizes="90px" />
                  </div>
                )
              }
            </div>
            <p class="kit-swatch__name">posarsi</p>
            <p class="kit-mono">--tiz-dur-settle · 800ms · sfalsato 90ms</p>
            <p class="kit-note">Il quadro sale di 22 px e si posa. .tiz-settle o [data-reveal].</p>
          </li>
          <li>
            <div class="kit-motion__stage">
              <span class="kit-motion__beat"><span class="kit-rosso">cuore</span><span class="kit-dot" /></span>
            </div>
            <p class="kit-swatch__name">battito</p>
            <p class="kit-mono">--tiz-dur-beat · 1600ms · tiz-beat</p>
            <p class="kit-note">Unico gesto in loop, una volta per pagina. Tutto si ferma con «riduci movimento».</p>
          </li>
        </ul>
        <button class="tiz-btn tiz-btn--dark kit-replay" type="button" data-kit-replay>↻ Rivedi le animazioni</button>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="k-pezzi">
      <h2 class="kit-label" id="k-pezzi">pezzi</h2>
      <div class="kit-pieces">
        <div class="kit-piece">
          <p class="kit-mono">.tiz-btn · .tiz-btn--dark</p>
          <a class="tiz-btn" href={routes.contatti}>Chiedi di quest’opera →</a>
          <button class="tiz-btn tiz-btn--dark" type="button">Vedi le opere</button>
          <button class="tiz-btn" type="button" disabled>Invio…</button>
        </div>
        <div class="kit-piece">
          <p class="kit-mono">.tiz-btn--round</p>
          <div class="kit-row">
            <a class="tiz-btn tiz-btn--round" href={routes.opere} aria-label="Opera precedente">←</a>
            <a class="tiz-btn tiz-btn--round" href={routes.opere} aria-label="Opera successiva">→</a>
          </div>
        </div>
        <div class="kit-piece">
          <p class="kit-mono">.tiz-marker</p>
          <a class="tiz-marker" href={routes.opere}>Tutte le opere →</a>
          <a class="tiz-marker" href={routes.contatti}>Scrivimi →</a>
        </div>
        <div class="kit-piece">
          <p class="kit-mono">didascalia</p>
          <div>
            <p class="kit-caption">Sorellanza</p>
            <p class="t-small kit-muted">2023 · 120 × 150 cm · acrilico su tela</p>
          </div>
        </div>
        <div class="kit-piece kit-piece--field">
          <p class="kit-mono">campo (stile, da Contatti)</p>
          <label class="kit-field">
            <span>Il tuo nome</span>
            <input type="text" value="Giulia" autocomplete="off" />
          </label>
        </div>
        <div class="kit-piece">
          <p class="kit-mono">menu (attivo = --tiz-marker-nav)</p>
          <p class="kit-navdemo"><span class="kit-navdemo__on">Opere</span><span>Chi sono</span><span>Contatti</span></p>
        </div>
        <div class="kit-piece kit-piece--wide">
          <p class="kit-mono">regola d’oro</p>
          <p class="kit-note">
            La tela è sempre intera, dritta, nei suoi colori. Il colore del sito vive dietro e attorno, mai sopra. Ombra leggera
            sotto (--tiz-shadow-tela), come appesa a un chiodo.
          </p>
        </div>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="k-pennellate">
      <h2 class="kit-label" id="k-pennellate">pennellate</h2>
      <div>
        <p class="kit-note kit-gap">
          &lt;Stroke&gt; dietro un quadro: il genitore ha position: relative e isolation: isolate. Cicli SWL / SWT / SWR (strokeAt) per
          indice mod 4; forma 1 e 2; i cinque colori.
        </p>
        <ul class="kit-strokes" role="list">
          {
            strokeSamples.map((opera, i) => {
              const place = strokeAt(i);
              return (
                <li class="kit-strokes__item">
                  <div class="kit-strokes__work">
                    <Stroke color={paintVar(PAINTS[i % PAINTS.length])} left={place.left} top={place.top} width="80%" height="70%" rotate={place.rotate} shape={i % 2 === 0 ? 1 : 2} />
                    <ResponsivePicture image={opera.data.immagini[0]} alt={altText(opera.data)} preset="thumb" sizes="160px" />
                  </div>
                  <p class="kit-mono">
                    strokeAt({i}) · {PAINTS[i % PAINTS.length]} · forma {i % 2 === 0 ? 1 : 2}
                  </p>
                </li>
              );
            })
          }
        </ul>
        <ul class="kit-paints" role="list">
          {
            PAINTS.map((paint) => (
              <li>
                <span class="kit-paints__blob">
                  <Stroke color={paintVar(paint)} inset="0" rotate="-3deg" />
                </span>
                <span class="kit-mono">{paint}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="k-header">
      <h2 class="kit-label" id="k-header">intestazione</h2>
      <div>
        <p class="kit-note kit-gap">
          In cima a questa pagina: l’intestazione vera (desktop ≥ 640, telefono &lt; 640). Qui sotto: la pagina Opere (voce attiva) e il
          telefono con il menu chiuso e aperto (Esc chiude, Tab resta dentro). Senza JavaScript, al telefono, i tre link stanno in una
          riga sotto «TIZ».
        </p>
        <iframe class="kit-frame kit-frame--wide" src={routes.opere} title="Intestazione desktop, voce Opere attiva" loading="lazy"></iframe>
        <div class="kit-phones">
          <iframe class="kit-frame kit-frame--phone" src={withBase('kit/header/')} title="Telefono, menu chiuso" loading="lazy"></iframe>
          <iframe class="kit-frame kit-frame--phone" src={withBase('kit/header/#aperto')} title="Telefono, menu aperto" loading="lazy"></iframe>
        </div>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="k-footer">
      <h2 class="kit-label" id="k-footer">piè di pagina</h2>
      <div class="kit-footers">
        <p class="kit-mono">&lt;SiteFooter /&gt;</p>
        <div class="kit-footers__box"><SiteFooter /></div>
        <p class="kit-mono">&lt;SiteFooter variant="home" /&gt; (BaseLayout footerVariant="home")</p>
        <div class="kit-footers__box"><SiteFooter variant="home" /></div>
      </div>
    </section>

    <section class="kit-section kit-section--full" aria-labelledby="k-tutte">
      <h2 class="kit-label" id="k-tutte">appese, tutte</h2>
      <p class="kit-note kit-gap">&lt;HungWorks opere=&#123;getPublishedOpere()&#125; /&gt; · {published.length} opere</p>
      <HungWorks opere={published} label="Tutte le opere" />
    </section>

    <section class="kit-section kit-section--full" aria-labelledby="k-tre">
      <h2 class="kit-label" id="k-tre">appese, tre</h2>
      <p class="kit-note kit-gap">&lt;HungWorks opere=&#123;[estasi, e-fuori-piove, guardami]&#125; transitionNames=&#123;false&#125; /&gt; (frame 1l)</p>
      <HungWorks opere={three} transitionNames={false} label="Tre opere" />
    </section>

    <section class="kit-section" aria-labelledby="k-dati">
      <h2 class="kit-label" id="k-dati">composizione</h2>
      <dl class="kit-data">
        <dt>mottoParts(profilo.motto)</dt>
        <dd>
          {motto.lines.length > 0 ? motto.lines.map((line) => <span class="kit-chip">{line}</span>) : <i>vuoto → nome dell’artista</i>}
          {motto.lastWord && <span class="kit-mono"> lastWord = «{motto.lastWord}»</span>}
        </dd>
        <dt>splitLastWord(profilo.motto)</dt>
        <dd class="kit-caption">
          {mottoFull.before}<span class="kit-rosso">{mottoFull.word}</span>{mottoFull.after}
        </dd>
        <dt>heroSlots</dt>
        <dd>
          large = {hero.large?.opera.data.titolo ?? '—'} · narrow = {hero.narrow?.opera.data.titolo ?? '—'} · small = {hero.small?.opera.data.titolo ?? '—'}
        </dd>
        <dt>pickQuote</dt>
        <dd>
          {
            quote ? (
              <span class="kit-caption">
                «{quote.before}
                <span class="kit-rosso">{quote.keyWord}</span>
                {quote.after}» — {published.find((o) => o.id === quote.id)?.data.titolo}
              </span>
            ) : (
              <i>nessuna citazione → fascia nascosta</i>
            )
          }
        </dd>
        <dt>pickSeries</dt>
        <dd>
          {series.name ?? 'Le ultime opere'}
          {series.year && ` · ${series.year}`} · {series.works.map((w) => w.opera.data.titolo).join(', ')}
          {series.name && SERIE_NOTE[series.name] && <span class="kit-note kit-block">SERIE_NOTE: {SERIE_NOTE[series.name]}</span>}
        </dd>
        <dt>colore (operaPaint)</dt>
        <dd class="kit-paintlist">
          {
            published.map((opera) => (
              <span class="kit-chip" style={`--chip: ${paintVar(operaPaint(opera, published))}`}>
                {opera.data.titolo}: {operaPaint(opera, published)}
              </span>
            ))
          }
        </dd>
        <dt>realScaleSizes(150)</dt>
        <dd class="kit-mono">{realScaleSizes(150)}</dd>
      </dl>
    </section>
  </div>
</BaseLayout>

<script>
  // Kit only: restart the demo animations (cloning a node restarts its CSS animations).
  document.querySelector('[data-kit-replay]')?.addEventListener('click', () => {
    document.querySelectorAll('[data-kit-replay-area] .kit-motion__stage').forEach((stage) => {
      stage.replaceWith(stage.cloneNode(true));
    });
  });
</script>

<style>
  .kit {
    --kit-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    padding-bottom: var(--tiz-s7);
  }

  .kit-mono {
    color: var(--tiz-terra-2);
    font: 500 12px/1.5 var(--kit-mono);
    overflow-wrap: anywhere;
  }

  .kit-mono--warm {
    margin-bottom: 6px;
    color: var(--tiz-terracotta);
  }

  .kit-note {
    color: var(--tiz-terra-3);
    font-size: var(--tiz-small);
    line-height: 1.45;
  }

  .kit-gap {
    margin-bottom: var(--tiz-s5);
  }

  .kit-block {
    display: block;
    margin-top: var(--tiz-s2);
  }

  .kit-muted {
    color: var(--tiz-terra-2);
  }

  .kit-rosso {
    color: var(--tiz-rosso);
  }

  .kit-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--tiz-s5) 40px;
    padding-block: var(--tiz-s5) var(--tiz-s6);
  }

  .kit-tiz {
    color: var(--tiz-rosso);
    font: 400 150px/0.9 var(--tiz-font-mano);
  }

  .kit-lead {
    max-width: 440px;
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.35;
  }

  .kit-section {
    display: grid;
    gap: var(--tiz-s4) 40px;
    padding-block: 40px 56px;
    border-top: var(--tiz-divider);
  }

  .kit-label {
    font: 400 36px/1 var(--tiz-font-mano);
    letter-spacing: 0;
  }

  @media (min-width: 1024px) {
    .kit-section {
      grid-template-columns: 180px minmax(0, 1fr);
    }

    .kit-section--3 {
      grid-template-columns: 180px minmax(0, 1fr) minmax(0, 1fr);
    }

    .kit-section--full {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* colours */
  .kit-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 36px 28px;
  }

  .kit-swatch {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .kit-swatch__paint {
    position: relative;
    isolation: isolate;
    height: 96px;
  }

  .kit-swatch__paint :global(.kit-swatch__light) {
    border: 1.5px solid var(--tiz-filo);
  }

  .kit-swatch__name,
  .kit-caption {
    font: 400 30px/1 var(--tiz-font-mano);
  }

  /* type */
  .kit-type {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }

  .kit-type__pair {
    display: grid;
    gap: var(--tiz-s5) 40px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--tiz-gesso);
  }

  @media (min-width: 640px) {
    .kit-type__pair {
      grid-template-columns: 1fr 1fr;
    }
  }

  .kit-type__mano {
    font: 400 72px/0.95 var(--tiz-font-mano);
  }

  .kit-type__row {
    display: grid;
    gap: 6px 24px;
    align-items: baseline;
  }

  @media (min-width: 640px) {
    .kit-type__row {
