---
/**
 * Opere (frames 1d / 1e / 1l, CONTRACTS §5.1): ONE list of all published works in display order,
 * hung by eye at real relative scale (HungWorks), under the title and the handwritten note
 * "{n} tele, appese come nello studio" ("{n} tele" on phones; "1 tela"). No grouping by series.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HungWorks from '../../components/HungWorks.astro';
import { SITE } from '../../components/lib/site';
import { getPublishedOpere, groupByCollezione } from '../../components/lib/opere';
import { opereCountNote } from '../../components/lib/home';

const opere = await getPublishedOpere();
const series = groupByCollezione(opere)
  .map((group) => group.collezione)
  .filter(Boolean);
const quoted = series.map((name) => `«${name}»`).join(', ');
const note = opereCountNote(opere.length);

const description =
  `Tutte le opere di ${SITE.nome} (${SITE.firma})` +
  (series.length > 0 ? `, tra cui ${series.length > 1 ? 'le serie' : 'la serie'} ${quoted}` : '.');
---

<BaseLayout title="Opere" description={description} path="opere/">
  <div class="opere container">
    <header class="opere__head">
      <h1 class="opere__title">Opere</h1>
      {
        opere.length > 0 && (
          <p class="opere__note tiz-write" style="--d: .3s">
            {note.short}<span class="opere__note-rest">{note.rest}</span>
          </p>
        )
      }
    </header>

    {
      opere.length === 0 ? (
        <p class="opere__empty">Le opere saranno pubblicate presto.</p>
      ) : (
        <div class="opere__list">
          <HungWorks opere={opere} headingLevel={2} priorityCount={3} label="Tutte le opere" />
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .opere__head {
    padding-block: 28px var(--tiz-s2);
  }

  .opere__title {
    font: 800 84px/0.85 var(--tiz-font-voce);
    letter-spacing: -0.05em;
  }

  .opere__note {
    margin-top: var(--tiz-s2);
    color: var(--tiz-terracotta);
    font: 400 32px/1 var(--tiz-font-mano);
    transform: rotate(-3deg);
  }

  /* Phones: "12 tele" only (frame 1e). */
  .opere__note-rest {
    display: none;
  }

  .opere__list {
    padding-block: 36px 72px;
  }

  .opere__empty {
    padding-block: 36px 72px;
    font-size: var(--tiz-lead);
  }

  @media (min-width: 640px) {
    .opere__head {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 16px 36px;
      padding-block: 56px 24px;
    }

    .opere__title {
      font-size: 120px;
      line-height: 0.8;
    }

    .opere__note {
      margin: 0 0 6px;
      font-size: 44px;
    }

    .opere__note-rest {
      display: inline;
    }

    .opere__list {
      padding-block: 40px var(--tiz-s8);
    }
  }

  @media (min-width: 1024px) {
    .opere__title {
      font-size: 150px;
    }
  }
</style>
