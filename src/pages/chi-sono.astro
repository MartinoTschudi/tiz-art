---
/**
 * About the artist: motto, bio and a picture — her portrait when the admin has one, otherwise the
 * first work of the home-page selection (linked to its page).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PlainText from '../components/PlainText.astro';
import ResponsivePicture from '../components/ResponsivePicture.astro';
import { SITE, routes } from '../components/lib/site';
import { altText, excerpt, getFeaturedOpere, getProfilo } from '../components/lib/opere';
import { socialImage } from '../components/lib/images';
import { personJsonLd } from '../components/lib/structured-data';

const profilo = await getProfilo();
const portraitAlt = `Ritratto di ${SITE.nome}`;
const portraitShare = profilo.ritratto ? await socialImage(profilo.ritratto, portraitAlt) : undefined;
const work = profilo.ritratto ? undefined : (await getFeaturedOpere())[0];
const description = excerpt(profilo.bio || profilo.motto || `${SITE.nome} (${SITE.firma}), pittrice.`);
const imageSizes = '(min-width: 64rem) 34vw, 92vw';
---

<BaseLayout
  title="Chi sono"
  description={description}
  path="chi-sono/"
  ogImage={portraitShare}
  jsonLd={[personJsonLd({ description: profilo.motto || undefined, image: portraitShare?.url })]}
>
  <div class="about container">
    <PageHeader eyebrow={SITE.nome} title="Chi sono" />

    <div class="about__body">
      <div class="about__text">
        {
          profilo.motto && (
            <blockquote class="about__motto">
              <p>{profilo.motto}</p>
            </blockquote>
          )
        }
        <div class="about__bio">
          <PlainText text={profilo.bio} />
        </div>
        <p class="about__links">
          <a class="button" href={routes.opere}>Vedi le opere</a>
          <a class="button button--quiet" href={routes.contatti}>Scrivimi</a>
        </p>
      </div>

      {
        profilo.ritratto && (
          <figure class="about__figure">
            <ResponsivePicture image={profilo.ritratto} alt={portraitAlt} preset="card" sizes={imageSizes} priority />
          </figure>
        )
      }
      {
        work && (
          <figure class="about__figure">
            <a href={routes.opera(work.id)}>
              <ResponsivePicture image={work.data.immagini[0]} alt={altText(work.data)} preset="card" sizes={imageSizes} priority />
            </a>
            <figcaption class="about__caption">
              «{work.data.titolo}»{work.data.anno && `, ${work.data.anno}`}
            </figcaption>
          </figure>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .about__body {
    display: grid;
    gap: var(--space-8);
  }

  .about__figure {
    max-width: 28rem;
  }

  .about__figure :global(img) {
    width: 100%;
    height: auto;
    box-shadow: var(--shadow-art);
  }

  .about__caption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .about__motto {
    max-width: 24ch;
    margin-bottom: var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    line-height: var(--leading-snug);
  }

  .about__motto::before {
    content: '';
    display: block;
    width: 3rem;
    height: 2px;
    margin-bottom: var(--space-4);
    background: var(--color-highlight);
  }

  .about__bio {
    font-size: var(--text-lg);
  }

  .about__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  @media (min-width: 64rem) {
    .about__body {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }

    .about__figure {
      justify-self: end;
      /* full width of its column (max 28rem) before the image loads: no jump, no 0×0 figure */
      width: 100%;
    }
  }
</style>
