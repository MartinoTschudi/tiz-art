---
/**
 * About the artist (frames 1h desktop, 1i phone): her portrait with an ocra brushstroke and the note
 * "nello studio" — or, without a portrait, the first hero painting, uncropped, captioned «titolo», anno
 * and linked to its page — next to "chi sono", her name (h1), the motto (last word in rosso), her bio
 * (`profilo.bio`, plain text) and the links to the works and to the contact page.
 *
 * Desktop (≥ 1024): picture left (it stays in view while the long bio scrolls, when the window is tall
 * enough), text right (max 620px). Below 1024 everything stacks: "chi sono" + name, the picture, then
 * the motto, the bio and the links. Empty motto or bio: that block is left out.
 *
 * Under it, as a block of its own, the exhibition «noi, DONNA.» (2023) with its film (CONTRACTS §5.6;
 * added after the design handoff, no frame): the same two columns, the film under the portrait and
 * its title, place, dates and own words under the bio; stacked below 1024: title → film → words.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ChiFigure from '../components/chi/ChiFigure.astro';
import ChiFilm from '../components/chi/ChiFilm.astro';
import PlainText from '../components/PlainText.astro';
import { SITE, absoluteUrl, routes, withBase } from '../components/lib/site';
import { altText, excerpt, firstHeroWork, getProfilo, getPublishedOpere, operaPaintVar } from '../components/lib/opere';
import { mottoParts, splitLastWord } from '../components/lib/composition';
import { socialImage } from '../components/lib/images';
import { filmJsonLd, personJsonLd } from '../components/lib/structured-data';
import { FILM_PATH, MOSTRA } from '../components/lib/film';
import filmPoster from '../assets/video/noi-donna-2023.jpg';

const [profilo, published] = await Promise.all([getProfilo(), getPublishedOpere()]);

const portraitAlt = `Ritratto di ${SITE.nome}`;
const portraitShare = profilo.ritratto ? await socialImage(profilo.ritratto, portraitAlt) : undefined;

// Without a portrait: the first work of the home hero (its first featured work in display order).
const work = profilo.ritratto ? undefined : firstHeroWork(published);
const workShare = work ? await socialImage(work.data.immagini[0], altText(work.data)) : undefined;

const description = excerpt(profilo.bio || profilo.motto || `${SITE.nome} (${SITE.firma}), pittrice.`);
// The motto as she wrote it (punctuation kept), its last word in rosso.
const motto = mottoParts(profilo.motto).lines.length > 0 ? splitLastWord(profilo.motto) : null;
const hasBio = profilo.bio.trim() !== '';
const hasPicture = Boolean(profilo.ritratto || work);

// The film's JSON-LD thumbnail: a JPEG of the poster (search engines do not all read AVIF / WebP).
const filmThumb = await socialImage(filmPoster, `Un fotogramma del film della mostra «${MOSTRA.titolo}»`);
const filmUrl = absoluteUrl(withBase(FILM_PATH));
---

<BaseLayout
  title="Chi sono"
  description={description}
  path="chi-sono/"
  ogImage={portraitShare ?? workShare}
  jsonLd={[
    personJsonLd({ description: profilo.motto || undefined, image: portraitShare?.url }),
    filmJsonLd({ contentUrl: filmUrl, thumbnailUrl: filmThumb.url }),
  ]}
>
  <div class="chi">
    <div class:list={['chi__grid container', !hasPicture && 'chi__grid--solo']}>
      <hgroup class="chi__head">
        <p class="chi__label">chi sono</p>
        <h1 class="chi__name">{SITE.nome}</h1>
      </hgroup>

      {
        hasPicture && (
          <div class="chi__picture">
            {profilo.ritratto ? (
              <ChiFigure kind="ritratto" image={profilo.ritratto} alt={portraitAlt} caption="nello studio" paint="var(--tiz-ocra)" />
            ) : (
              work && (
                <ChiFigure
                  kind="opera"
                  image={work.data.immagini[0]}
                  alt={altText(work.data)}
                  caption={`«${work.data.titolo}»${work.data.anno ? `, ${work.data.anno}` : ''}`}
                  paint={operaPaintVar(work, published)}
                  href={routes.opera(work.id)}
                  transitionName={`opera-${work.id}`}
                />
              )
            )}
          </div>
        )
      }

      <div class="chi__text">
        {
          motto && (
            <p class="chi__motto" data-reveal="write" style="--tiz-reveal-delay: 400ms">
              {motto.before}
              {motto.word && <span class="chi__heart">{motto.word}</span>}
              {motto.after}
            </p>
          )
        }
        {
          hasBio && (
            <div class="chi__bio">
              <PlainText text={profilo.bio} />
            </div>
          )
        }
        <p class="chi__links">
          <a class="tiz-btn tiz-btn--dark" href={routes.opere}>Vedi le opere</a>
          <a class="tiz-marker" href={routes.contatti}>Scrivimi <span aria-hidden="true">→</span></a>
        </p>
      </div>
    </div>

    <section class="chi__grid chi__grid--mostra container" id="mostra" aria-labelledby="mostra-titolo">
      <hgroup class="chi__head">
        <p class="chi__label">la mostra</p>
        <h2 class="chi__mostra-title" id="mostra-titolo">{MOSTRA.titolo}</h2>
        {/* One sentence for a screen reader and for whoever copies it: the comma and the space are in
            the text, the middle dot of the wide layout is drawn by CSS. */}
        <p class="chi__mostra-where">
          <span class="chi__mostra-fact">{MOSTRA.luogo}<span class="visually-hidden">,</span></span> <span class="chi__mostra-fact">{MOSTRA.date}</span>
        </p>
      </hgroup>

      <div class="chi__film">
        <ChiFilm poster={filmPoster} />
      </div>

      <div class="chi__text">
        <p class="chi__tributo">«{MOSTRA.tributo}»</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* The stroke behind the picture reaches into the gutter: clip at the page edge, never scroll sideways. */
  .chi {
    overflow-x: clip;
  }

  /* Phone first (frame 1i): one column — "chi sono" + name, the picture, then motto, bio, links. */
  .chi__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'head'
      'picture'
      'text';
    padding-block: var(--tiz-s4) 56px;
  }

  .chi__head {
    grid-area: head;
    max-width: var(--tiz-measure);
  }

  .chi__label {
    width: fit-content;
    color: var(--tiz-terracotta);
    font: 400 36px/1 var(--tiz-font-mano);
    transform: rotate(-2deg);
    transform-origin: left;
  }

  .chi__name {
    margin-top: var(--tiz-s1);
    font-size: var(--tiz-h1-name);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    /* As in frame 1i ("Tiziana Tschudi / Belloli"); balanced from 1024 (frame 1h). */
    text-wrap: wrap;
  }

  .chi__picture {
    grid-area: picture;
    margin-top: 40px;
  }

  .chi__text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: var(--tiz-measure);
    /* Frame 1i has 40px under the picture; the note "nello studio" already takes part of it. */
    padding-top: 28px;
  }

  .chi__motto {
    font: 400 48px/1 var(--tiz-font-mano);
    /* Keep the line breaks of the design: the last word may stand alone. */
    text-wrap: wrap;
    overflow-wrap: break-word;
  }

  .chi__heart {
    color: var(--tiz-rosso);
  }

  /* 18px text on phones (frame 1i), 20px from 640; paragraphs 18px apart as in both frames. */
  .chi__bio,
  .chi__tributo {
    --plain-text-gap: 18px;
    font-size: 18px;
    line-height: 1.6;
  }

  .chi__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--tiz-s3) 28px;
    margin-top: 6px;
  }

  /* Frame 1h: the dark button is 52px high, padding 0 24px. */
  .chi__links .tiz-btn {
    height: 52px;
    padding-inline: 24px;
  }

  @media (min-width: 640px) {
    .chi__grid {
      padding-block: var(--tiz-s5) var(--tiz-s7);
    }

    .chi__label {
      font-size: 40px;
    }

    .chi__picture {
      margin-top: var(--tiz-s6);
    }

    .chi__text {
      gap: 22px;
      padding-top: 36px;
    }

    .chi__motto {
      font-size: 56px;
    }

    .chi__bio,
    .chi__tributo {
      font-size: 20px;
    }
  }

  /* Desktop (frame 1h): grid 460px 1fr, gap 88px; the picture spans both rows of the right column. */
  @media (min-width: 1024px) {
    .chi__grid {
      grid-template-columns: clamp(430px, 36vw, 460px) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'picture head'
        'picture text';
      column-gap: clamp(56px, 6.875vw, 88px);
      align-items: start;
      padding-block: 56px 96px;
    }

    .chi__grid--solo {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'text';
    }

    .chi__label {
      font-size: 44px;
    }

    .chi__name {
      margin-top: var(--tiz-s4);
      line-height: 0.88;
      text-wrap: balance;
    }

    .chi__picture {
      margin-top: 40px;
    }

    .chi__text {
      gap: 28px;
      padding-top: 28px;
    }

    .chi__motto {
      font-size: 64px;
      text-wrap: balance;
    }

    .chi__links {
      margin-top: 0;
    }
  }

  /* The bio is long: the picture stays in view while it scrolls (only where the whole picture fits). */
  @media (min-width: 1024px) and (min-height: 720px) {
    .chi__picture {
      position: sticky;
      top: 40px;
    }
  }

  /* ── The exhibition and its film (CONTRACTS §5.6; no frame: it repeats the grid, the label and the
     text sizes of the block above, and the film hangs on the portrait's line). These rules come after
     the block's own, so they win over .chi__grid at every width. ── */

  /* A dashed line sets it apart from the bio; the space above it is the first grid's bottom padding. */
  .chi__grid--mostra {
    grid-template-areas:
      'rule'
      'head'
      'picture'
      'text';
    padding-top: 0;
  }

  .chi__grid--mostra::before {
    content: '';
    grid-area: rule;
    margin-bottom: 40px;
    border-top: var(--tiz-divider);
  }

  /* The series name as on the home page (HomeSeries): Bricolage 800, tight. */
  .chi__mostra-title {
    margin-top: var(--tiz-s2);
    font-size: 48px;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .chi__mostra-where {
    margin-top: var(--tiz-s3);
    color: var(--tiz-terra-2);
    font-size: 15px;
    font-weight: 500;
    line-height: var(--tiz-line-small);
  }

  /* Phone: the place and the dates on a line each; from 640 one line, a middle dot between them. */
  .chi__mostra-fact {
    display: block;
  }

  .chi__film {
    grid-area: picture;
    margin-top: var(--tiz-s5);
  }

  @media (min-width: 640px) {
    .chi__grid--mostra::before {
      margin-bottom: 56px;
    }

    .chi__mostra-title {
      font-size: 56px;
    }

    .chi__mostra-where {
      font-size: var(--tiz-body);
    }

    .chi__mostra-fact {
      display: inline;
    }

    /* The dot is generated: it is not copied with the line («Atelier Attila, Bellinzona, 22 aprile –
       7 maggio 2023») and, where the browser knows the empty alternative text, not read aloud. */
    .chi__mostra-fact + .chi__mostra-fact::before {
      content: '· ';
      content: '· ' / '';
    }

    .chi__film {
      margin-top: 40px;
    }
  }

  /* Desktop: the film in the portrait's column, the text in the bio's. The film is taller than its
     text: title and words meet at half its height, like the label beside a painting. */
  @media (min-width: 1024px) {
    .chi__grid--mostra {
      grid-template-rows: auto 1fr 1fr;
      grid-template-areas:
        'rule rule'
        'picture head'
        'picture text';
    }

    .chi__grid--mostra::before {
      margin-bottom: 72px;
    }

    .chi__grid--mostra .chi__head {
      align-self: end;
    }

    .chi__mostra-title {
      margin-top: var(--tiz-s3);
      font-size: 64px;
    }

    .chi__film {
      margin-top: 0;
    }
  }
</style>
