---
/**
 * Contatti (frames 1j desktop, 1k phone; 1j-sent / 1k-sent after sending). The form is the only way to
 * reach the artist: no e-mail, phone or address anywhere.
 *
 * Left (on top below 1024 px): the ottanio stroke block with "Scrivimi" (the page's h1). Right: the
 * form (ContactForm). `?opera=<slug>` from "Chiedi di quest’opera" shows the chosen work as a chip.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Pagina from '../components/contatti/Pagina.astro';
import { SITE } from '../components/lib/site';
import { getPublishedOpere } from '../components/lib/opere';

const opere = await getPublishedOpere();
---

<BaseLayout
  title="Contatti"
  description={`Scrivi a ${SITE.nome}: per un quadro, per vedere le tele dal vivo, o solo per due parole.`}
  path="contatti/"
>
  <Pagina titleId="contatti-titolo">
    <ContactForm opere={opere} labelledBy="contatti-titolo" />
  </Pagina>
</BaseLayout>
