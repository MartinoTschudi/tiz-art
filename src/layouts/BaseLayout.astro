---
/**
 * The frame of every public page: <head> (title, description, canonical, Open Graph, JSON-LD,
 * icons, robots), skip link, header, <main>, footer.
 *
 *   <BaseLayout title="Opere" description="…" path="opere/">…</BaseLayout>
 *
 * - `title`: the page name; the layout appends " — Tiziana Tschudi Belloli". Omit it on the home page
 *   ("Tiziana Tschudi Belloli — TIZ").
 * - `path`: route without base path, ending with "/" ("" = home). `null` = no canonical (404).
 * - `ogImage`: sharing image; default = the cover of the first hero work (lib/opere.ts → firstHeroWork).
 * - `footerVariant`: "home" for the large home footer (SiteFooter).
 * - `headerBack`: phone-only back link in the header instead of the Menu button (SiteHeader `back`).
 *
 * Also here, once per page: the font preloads, the #tiz-rough SVG filter of the brushstrokes, the
 * `js` class on <html> (set before the first paint) and the reveal-on-scroll script for [data-reveal]
 * (see global.css). Page changes use native cross-document view transitions (global.css), not
 * Astro's ClientRouter: the vanilla scripts rely on normal page loads.
 */
import '../styles/global.css';
import manoFont from '../assets/fonts/tiz-mano.woff2?url';
import voceFont from '../assets/fonts/bricolage-grotesque.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, IS_PREVIEW, absoluteUrl, withBase } from '../components/lib/site';
import { altText, firstHeroWork, getPublishedOpere } from '../components/lib/opere';
import { socialImage, type SocialImage } from '../components/lib/images';
import { jsonLdScript, type JsonLd } from '../components/lib/structured-data';

interface Props {
  title?: string;
  description: string;
  path: string | null;
  ogImage?: SocialImage;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: JsonLd[];
  /** Keep this page out of search engines (always true on the GitHub Pages preview). */
  noindex?: boolean;
  footerVariant?: 'default' | 'home';
  headerBack?: { href: string; label: string };
}

const {
  title,
  description,
  path,
  ogImage,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  footerVariant = 'default',
  headerBack,
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.nome}` : `${SITE.nome} — ${SITE.firma}`;
const canonical = path === null ? undefined : absoluteUrl(withBase(path));

const fallbackCover = ogImage ? undefined : firstHeroWork(await getPublishedOpere());
const image =
  ogImage ?? (fallbackCover && (await socialImage(fallbackCover.data.immagini[0], altText(fallbackCover.data))));
---

<!doctype html>
<html lang={SITE.lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // Before the first paint: CSS may now hide [data-reveal] elements until they are revealed and
      // shows the phone Menu button instead of the row of links. The module scripts below run before
      // DOMContentLoaded; if the reveal or the menu script did not run to the end (old browser, an
      // error), go back to the no-JS page: everything visible, the links as a row.
      document.documentElement.classList.add('js');
      document.addEventListener('DOMContentLoaded', function () {
        var ready = document.documentElement.dataset;
        if (ready.reveal !== 'ready' || ready.menu !== 'ready') document.documentElement.classList.remove('js');
      });
    </script>
    <link rel="preload" href={voceFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manoFont} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(IS_PREVIEW || noindex) && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:locale" content="it_CH" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      image && (
        <>
          <meta property="og:image" content={image.url} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta property="og:image:alt" content={image.alt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <!-- Same value as --tiz-lino in src/styles/tokens.css -->
    <meta name="theme-color" content="#f3ecdf" />
    <meta name="generator" content={Astro.generator} />

    {jsonLd.length > 0 && <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <SiteHeader back={headerBack} />
    <main id="contenuto" class="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter variant={footerVariant} />
    <svg class="tiz-filters" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="tiz-rough" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="7"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" scale="34"></feDisplacementMap>
      </filter>
    </svg>
  </body>
</html>

<script>
  // Reveal on scroll: [data-reveal] elements get .is-in when they enter the viewport (global.css runs
  // the animation). Elements revealed together are staggered in document order: the n-th gets
  // --tiz-reveal-step: n and waits n × --tiz-stagger, unless it sets its own --tiz-reveal-delay inline.
  const MAX_STEPS = 7;
  const root = document.documentElement;
  const pending = [...document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)')];

  const reveal = (elements: HTMLElement[]) => {
    elements.forEach((el, i) => {
      if (!el.style.getPropertyValue('--tiz-reveal-delay')) {
        el.style.setProperty('--tiz-reveal-step', String(Math.min(i, MAX_STEPS)));
      }
      el.classList.add('is-in');
    });
  };

  if (!('IntersectionObserver' in window)) {
    reveal(pending);
  } else {
    // What is already on screen is revealed at once (also the target of a view transition).
    const inView = (el: HTMLElement) => {
      const box = el.getBoundingClientRect();
      return box.bottom > 0 && box.top < window.innerHeight && box.width > 0;
    };
    reveal(pending.filter(inView));
    const observer = new IntersectionObserver(
      (entries) => {
        const shown = entries.filter((entry) => entry.isIntersecting).map((entry) => entry.target as HTMLElement);
        shown.forEach((el) => observer.unobserve(el));
        reveal(shown);
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.1 },
    );
    pending.filter((el) => !el.classList.contains('is-in')).forEach((el) => observer.observe(el));
  }
  root.dataset.reveal = 'ready';
</script>

<style>
  .main {
    flex: 1;
  }

  .tiz-filters {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .main:focus {
    outline: none;
  }
</style>
