---
/**
 * The frame of every public page: <head> (title, description, canonical, Open Graph, JSON-LD,
 * icons, robots), skip link, header, <main>, footer.
 *
 *   <BaseLayout title="Opere" description="…" path="opere/">…</BaseLayout>
 *
 * - `title`: the page name; the layout appends " — Tiziana Tschudi Belloli". Omit it on the home page
 *   ("Tiziana Tschudi Belloli — TIZ").
 * - `path`: route without base path, ending with "/" ("" = home). `null` = no canonical (404).
 * - `ogImage`: sharing image; default = cover of the first work in the home selection.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, IS_PREVIEW, absoluteUrl, withBase } from '../components/lib/site';
import { altText, getFeaturedOpere } from '../components/lib/opere';
import { socialImage, type SocialImage } from '../components/lib/images';
import { jsonLdScript, type JsonLd } from '../components/lib/structured-data';

interface Props {
  title?: string;
  description: string;
  path: string | null;
  ogImage?: SocialImage;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: JsonLd[];
  /** Keep this page out of search engines (always true on the GitHub Pages preview). */
  noindex?: boolean;
}

const { title, description, path, ogImage, ogType = 'website', jsonLd = [], noindex = false } = Astro.props;

const fullTitle = title ? `${title} — ${SITE.nome}` : `${SITE.nome} — ${SITE.firma}`;
const canonical = path === null ? undefined : absoluteUrl(withBase(path));

const fallbackCover = ogImage ? undefined : (await getFeaturedOpere())[0];
const image =
  ogImage ?? (fallbackCover && (await socialImage(fallbackCover.data.immagini[0], altText(fallbackCover.data))));
---

<!doctype html>
<html lang={SITE.lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(IS_PREVIEW || noindex) && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:locale" content="it_CH" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      image && (
        <>
          <meta property="og:image" content={image.url} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta property="og:image:alt" content={image.alt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <!-- Same value as --color-bg in src/styles/tokens.css -->
    <meta name="theme-color" content="#f6f3ee" />
    <meta name="generator" content={Astro.generator} />

    {jsonLd.length > 0 && <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <SiteHeader />
    <main id="contenuto" class="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .main {
    flex: 1;
  }

  .main:focus {
    outline: none;
  }
</style>
